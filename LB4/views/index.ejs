<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social Network</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; }
        .post-card { border-radius: 10px; border: none; box-shadow: 0 1px 2px rgba(0,0,0,0.1); margin-bottom: 20px; }
        .comment-section { background-color: #f8f9fa; border-radius: 8px; padding: 15px; margin-top: 15px; }
        .like-btn { cursor: pointer; transition: 0.2s; }
        .like-btn:hover { transform: scale(1.1); }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">SocialDB</a>
        <div class="d-flex">
            <% if (user && user.userId) { %>
                <% if (user.role === 'ADMIN') { %>
                    <a href="/admin" class="btn btn-warning me-2">Панель адміністратора</a>
                <% } %>
                <button class="btn btn-light" onclick="logout()">Вийти</button>
            <% } else { %>
                <span class="navbar-text text-white">Ви не авторизовані</span>
            <% } %>
        </div>
    </div>
</nav>

<div class="container">
    <div class="row justify-content-center">
        
        <% if (!user || !user.userId) { %>
        <div class="col-md-4 mb-4">
            <div class="card p-4 post-card">
                <h4>Вхід / Реєстрація</h4>
                <input type="text" id="username" class="form-control mb-2" placeholder="Логін">
                <input type="password" id="password" class="form-control mb-3" placeholder="Пароль">
                <div class="d-grid gap-2">
                    <button class="btn btn-primary" onclick="login()">Увійти</button>
                    <button class="btn btn-outline-secondary" onclick="register()">Зареєструватися як USER</button>
                    <button class="btn btn-outline-danger btn-sm mt-2" onclick="register('ADMIN')">Зареєструватися як ADMIN</button>
                </div>
            </div>
        </div>
        <% } %>

        <div class="col-md-8">
            
            <% if (user && user.userId) { %>
    <div class="card p-3 post-card">
        <textarea id="newPostContent" class="form-control mb-2" rows="2" placeholder="Що у вас нового?"></textarea>
        <div class="text-end">
            <button class="btn btn-primary" onclick="createPost()">Опублікувати</button>
        </div>
    </div>
    
    <div class="card p-3 post-card bg-light">
        <div class="row">
            <div class="col-sm-6 border-end">
                <h6 class="text-primary">Мої друзі:</h6>
                <div id="myFriendsList" class="d-flex flex-column gap-2"></div>
            </div>
            <div class="col-sm-6">
                <h6 class="text-success">Можливі друзі:</h6>
                <div id="potentialFriendsList" class="d-flex flex-wrap gap-2"></div>
            </div>
        </div>
    </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <div class="input-group w-50">
            <input type="text" id="searchInput" class="form-control" placeholder="Пошук постів...">
            <button class="btn btn-outline-secondary" onclick="executeSearch()">Шукати</button>
        </div>
        <div class="btn-group mt-2 mt-md-0">
            <button class="btn btn-sm btn-outline-primary active" onclick="loadPosts('date')" id="btn-date">Найновіші</button>
            <button class="btn btn-sm btn-outline-primary" onclick="loadPosts('likes')" id="btn-likes">Популярні</button>
        </div>
    </div>

    <div id="feed"></div>

        </div>
    </div>
</div>

<script>
    // Отримуємо дані сесії з сервера (EJS) у JavaScript
    const currentUserId = <%= (locals.user && user.userId) ? user.userId : 'null' %>;
    const currentUserRole = '<%= (locals.user && user.role) ? user.role : "USER" %>';

    // --- АВТОРИЗАЦІЯ ---
    async function login() {
        const u = document.getElementById('username').value;
        const p = document.getElementById('password').value;
        const res = await fetch('/api/login', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({username: u, password: p}) });
        if (res.ok) window.location.reload(); else alert((await res.json()).error);
    }

    async function register(role = 'USER') {
        const u = document.getElementById('username').value;
        const p = document.getElementById('password').value;
        const res = await fetch('/api/register', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({username: u, password: p, role}) });
        if (res.ok) alert("Успішно! Тепер увійдіть."); else alert((await res.json()).error);
    }

    async function logout() {
        await fetch('/api/logout', { method: 'POST' });
        window.location.reload();
    }

    // --- ВЗАЄМОДІЯ З ПОСТАМИ ---
    async function createPost() {
        const content = document.getElementById('newPostContent').value;
        if (!content) return;
        await fetch('/api/posts', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({content}) });
        document.getElementById('newPostContent').value = '';
        loadPosts();
    }

    async function toggleLike(postId) {
        const res = await fetch(`/api/posts/${postId}/like`, { method: 'POST' });
        if (res.status === 401) return alert("Авторизуйтесь, щоб ставити лайки");
        loadPosts(currentSort); // Оновлюємо стрічку
    }

    async function addComment(postId) {
        const input = document.getElementById(`comment-input-${postId}`);
        if (!input.value) return;
        const res = await fetch(`/api/posts/${postId}/comments`, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({text: input.value}) });
        if (res.status === 401) return alert("Авторизуйтесь, щоб коментувати");
        loadPosts(currentSort);
    }

    function executeSearch() {
        const query = document.getElementById('searchInput').value;
        loadPosts(currentSort, query);
    }

    async function loadUsers() {
        const res = await fetch('/api/users');
        const data = await res.json();
        
        const myFriends = document.getElementById('myFriendsList');
        const potentialFriends = document.getElementById('potentialFriendsList');
        
        if (myFriends && potentialFriends) {
            myFriends.innerHTML = data.friends.length ? data.friends.map(f => `
                <div class="d-flex justify-content-between align-items-center bg-white p-1 border rounded mb-1">
                    <span class="fw-bold">@${f.username}</span>
                    <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeFriend(${f.id})">Видалити</button>
                </div>
            `).join('') : '<small class="text-muted">У вас ще немає друзів</small>';

            potentialFriends.innerHTML = data.potentialFriends.length ? data.potentialFriends.map(u => `
                <span class="badge bg-success p-2" style="cursor:pointer;" onclick="addFriend(${u.id})">
                    + Додати ${u.username}
                </span>
            `).join('') : '<small class="text-muted">Немає кого додавати</small>';
        }
    }

    async function addFriend(id) {
        await fetch(`/api/users/${id}/friend`, { method: 'POST' });
        loadUsers(); 
    }

    async function removeFriend(id) {
        await fetch(`/api/users/${id}/friend`, { method: 'DELETE' });
        loadUsers();
    }

    async function deletePost(id) {
        if (!confirm("Ви впевнені, що хочете видалити цей пост?")) return;
        const res = await fetch(`/api/posts/${id}`, { method: 'DELETE' });
        if (res.ok) loadPosts(currentSort);
        else alert((await res.json()).error);
    }

    async function deleteComment(id) {
        if (!confirm("Видалити коментар?")) return;
        const res = await fetch(`/api/comments/${id}`, { method: 'DELETE' });
        if (res.ok) loadPosts(currentSort);
        else alert((await res.json()).error);
    }

    // --- ВІДОБРАЖЕННЯ СТРІЧКИ ---
    let currentSort = 'date';
    
    async function loadPosts(sort = currentSort, search = '') {
        currentSort = sort;
        document.getElementById('btn-date').classList.toggle('active', sort === 'date');
        document.getElementById('btn-likes').classList.toggle('active', sort === 'likes');

        const res = await fetch(`/api/posts?sort=${sort}&search=${encodeURIComponent(search)}`);
        const posts = await res.json();
        
        const feed = document.getElementById('feed');
        feed.innerHTML = posts.map(post => `
            <div class="card post-card p-3">
                <div class="d-flex justify-content-between">
                    <strong>@${post.User.username}</strong>
                    <small class="text-muted">${new Date(post.createdAt).toLocaleString()}</small>
                    ${post.UserId === currentUserId || currentUserRole === 'ADMIN' ? 
                          `<button class="btn btn-sm btn-outline-danger py-0 px-1" title="Видалити пост" onclick="deletePost(${post.id})">🗑️</button>` : ''}
                </div>
                <p class="mt-2 fs-5">${post.content}</p>
                <hr class="my-2">
                <div class="d-flex align-items-center">
                    <span class="like-btn text-danger fw-bold fs-5 me-3" onclick="toggleLike(${post.id})">
                        ❤️ ${post.likesCount}
                    </span>
                    <span class="text-muted">💬 ${post.Comments.length}</span>
                </div>
                
                <div class="comment-section mt-3">
                    ${post.Comments.map(c => `
                        <div class="d-flex justify-content-between align-items-start mb-2 border-bottom pb-1">
                            <div><strong>${c.User.username}:</strong> ${c.text}</div>
                            ${c.UserId === currentUserId || currentUserRole === 'ADMIN' ? 
                              `<button class="btn btn-sm btn-link text-danger p-0" onclick="deleteComment(${c.id})">🗑️</button>` : ''}
                        </div>
                    `).join('')}
                    
                    <div class="input-group mt-2">
                        <input type="text" id="comment-input-${post.id}" class="form-control form-control-sm" placeholder="Написати коментар...">
                        <button class="btn btn-sm btn-outline-primary" onclick="addComment(${post.id})">Відправити</button>
                    </div>
                </div>
            </div>
        `).join('');
    }


    // Завантажуємо пости та користувачів при старті сторінки
    loadPosts();
    loadUsers();
</script>
</body>
</html>