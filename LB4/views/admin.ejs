<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <title>Системні Логи - Адмін</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-white">
    <div class="container mt-4">
      <div
        class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-4"
      >
        <h2>Моніторинг та Логування</h2>
        <a href="/" class="btn btn-outline-light">Повернутися до стрічки</a>
      </div>

      <div class="table-responsive">
        <table class="table table-dark table-striped table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Дія</th>
              <th>User ID</th>
              <th>Деталі</th>
              <th>Час</th>
            </tr>
          </thead>
          <tbody id="logsTable"></tbody>
        </table>
      </div>
    </div>

    <script>
      async function loadLogs() {
        const res = await fetch("/api/admin/logs");
        if (!res.ok) return alert("Помилка доступу!");

        const logs = await res.json();
        const tbody = document.getElementById("logsTable");

        tbody.innerHTML = logs
          .map(
            (log) => `
            <tr>
                <td>${log.id}</td>
                <td><span class="badge bg-primary">${log.action}</span></td>
                <td>${log.userId || "—"}</td>
                <td class="font-monospace text-warning">${log.details}</td>
                <td>${new Date(log.createdAt).toLocaleString()}</td>
            </tr>
        `,
          )
          .join("");
      }

      loadLogs();
    </script>
  </body>
</html>
